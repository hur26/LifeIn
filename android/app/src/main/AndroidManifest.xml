<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      权限按需要一样一样加,不预留。**永远不会出现的是推送相关的那些** ——
      没有厂商推送 SDK,不接收推送(铁律 10 / ADR-014)。
    -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!--
      相机只为**配码扫一次**(ADR-021 的 2026-09 改判)。
      点"扫码"那一刻才申请;不给也配得上 —— 粘贴那条路一直留着。
      这一点很要紧:一个"读你全部通知"的 App 要相机权限,
      唯一说得过去的形态就是"你要用的时候才要,不用就不要"。
    -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <!--
      日历要读也要写:写之前先查这条是不是已经写过(06 §6.8 那条"幂等责任
      在设备端")。只申请写权限的话,换手机恢复备份之后会写出两条一样的会。
    -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.WRITE_CALENDAR" />

    <!--
      以下三条全部只为副驾(P5,ADR-035 / ADR-036)。**装了不等于在用** ——
      无障碍和悬浮窗都要用户自己去系统设置里开,App 里还有总开关和逐 App 放行,
      一共四道,每一道默认都是关的(07 §2.9)。

      悬浮窗:副驾的展示面。选它而不是输入法,是因为输入法会看见你在**每个 App**
      里敲的**每一个键**,而副驾只该看见你主动打开的那个聊天窗(ADR-036)。

      前台服务:无障碍服务被 ROM 冻结之后不会自己回来 —— 通知监听有系统重绑,
      它没有。两者的容忍度差三个数量级,所以结论不同(ADR-021 的 2026-09-22 追加)。
    -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!--
        列出"能从桌面启动的应用",给放行来源那一格的应用选择器用(ADR-033)。

        Android 11 起包可见性默认是隔离的:不声明这一段,queryIntentActivities
        只看得到自己。**用 <queries> 而不是 QUERY_ALL_PACKAGES** —— 后者是
        敏感权限,而这里要的只是"有启动图标的应用"这一类,不是全部。
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:name=".LifeInApp"
        android:allowBackup="false"
        android:icon="@android:drawable/ic_menu_agenda"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.LifeIn">
        <!--
          allowBackup=false 是有意的:备份里会带上加密后的凭据和缓存的待办,
          而那份备份会去到云端。R11 说 App 本地缓存同样是攻击面。
        -->

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!--
          通知监听。系统绑定它,被杀了系统会重新绑 —— 所以不给它加前台服务
          (ADR-021)。真掉线了靠服务端的心跳告警发现,一小时内(P1 验收标准)。
        -->
        <service
            android:name=".collect.NotificationCollector"
            android:exported="false"
            android:label="@string/collector_label"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
        <!--
          副驾的读屏服务(ADR-035)。**注册的类名是伪装的** ——
          微信 8.0.52 起对普通命名的无障碍服务隐藏节点文本,而这个名字读得到。
          逻辑全在 .copilot.ChatCaptureService,这个类只是个空壳子。

          **不要改这个名字,但也不要在它失效之后去找下一个。**
          ADR-035 写了这条承诺:微信如果把它堵了,这个项目不追。

          android:label 和配置里的 description **没有伪装** ——
          伪装是为了让微信不屏蔽节点,不是为了让用户看不出这是谁(09 §1)。
        -->
        <service
            android:name="com.google.android.accessibility.selecttospeak.SelectToSpeakService"
            android:exported="true"
            android:label="@string/copilot_a11y_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/copilot_accessibility" />
        </service>
        <!--
          只为把进程钉在前台优先级,好让上面那个服务不被省电策略冻掉。
          specialUse 是如实归类:它不放音乐、不导航、不传文件 ——
          没有一个现成的类型说得清它在干什么,而硬套一个说得通的类型
          才是真正会被商店打回来的做法。
        -->
        <service
            android:name=".copilot.CopilotKeepAlive"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keeps the copilot accessibility reader alive under OEM power management" />
        </service>
        <!--
          桌面小组件。AppWidgetProvider + WorkManager **定时去拉**,
          没有任何一方向这台手机推送 —— 铁律 10 禁的是接收推送,不是主动刷新
          (ADR-020)。
        -->
        <receiver
            android:name=".widget.TodayWidget"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/today_widget_info" />
        </receiver>
    </application>
</manifest>
