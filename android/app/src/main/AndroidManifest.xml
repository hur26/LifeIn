<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      权限按需要一样一样加,不预留。**永远不会出现的是推送相关的那些** ——
      没有厂商推送 SDK,不接收推送(铁律 10 / ADR-014)。
    -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!--
      相机只为**配码扫一次**(ADR-021 的 2026-09 改判)。
      点"扫码"那一刻才申请;不给也配得上 —— 粘贴那条路一直留着。
      这一点很要紧:一个"读你全部通知"的 App 要相机权限,
      唯一说得过去的形态就是"你要用的时候才要,不用就不要"。
    -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <!--
      日历要读也要写:写之前先查这条是不是已经写过(06 §6.8 那条"幂等责任
      在设备端")。只申请写权限的话,换手机恢复备份之后会写出两条一样的会。
    -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.WRITE_CALENDAR" />

    <application
        android:name=".LifeInApp"
        android:allowBackup="false"
        android:icon="@android:drawable/ic_menu_agenda"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.LifeIn">
        <!--
          allowBackup=false 是有意的:备份里会带上加密后的凭据和缓存的待办,
          而那份备份会去到云端。R11 说 App 本地缓存同样是攻击面。
        -->

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!--
          通知监听。系统绑定它,被杀了系统会重新绑 —— 所以不给它加前台服务
          (ADR-021)。真掉线了靠服务端的心跳告警发现,一小时内(P1 验收标准)。
        -->
        <service
            android:name=".collect.NotificationCollector"
            android:exported="false"
            android:label="@string/collector_label"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
        <!--
          桌面小组件。AppWidgetProvider + WorkManager **定时去拉**,
          没有任何一方向这台手机推送 —— 铁律 10 禁的是接收推送,不是主动刷新
          (ADR-020)。
        -->
        <receiver
            android:name=".widget.TodayWidget"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/today_widget_info" />
        </receiver>
    </application>
</manifest>
