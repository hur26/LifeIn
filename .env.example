# LifeIn 环境变量示例 —— 完整说明见 docs/07-config.md
#
# 这份文件只放键名和格式,不放任何真实值。
# 复制为 .env 后填写;.env 已在 .gitignore 里,永远不要提交。

# ---------- 基础 ----------
DATABASE_URL=postgresql+psycopg://lifein:CHANGE_ME@127.0.0.1:5432/lifein
APP_HOST=127.0.0.1
APP_PORT=8000

# 反代之后、手机够得着的地址。配码二维码里写的就是它。
# 不填的话控制台的"添加设备"出不了码 —— 这个值不能从请求头推,
# 能设 Host 的人就能让一张码指向他自己的服务器(07 §2.1)
PUBLIC_BASE_URL=https://life.example.com
TZ=Asia/Shanghai
LOG_LEVEL=INFO

# ---------- 加密主密钥 ----------
# 生成:python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
# 泄露等于全部凭据泄露。不进仓库、不进日志、不进备份的明文部分。
MASTER_KEY=CHANGE_ME_BASE64_32_BYTES
MASTER_KEY_VERSION=1
# 轮换期间填旧密钥,轮换完成后删除本行
# MASTER_KEY_PREVIOUS=

# ---------- 外部模型(OpenAI 兼容,不绑厂商) ----------
LLM_BASE_URL=https://example.com/v1
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_S=60
LLM_MAX_RETRIES=2
EMBEDDING_MODEL=
EMBEDDING_DIM=1024

# 企业微信整组没了(ADR-026,2026-09-10)。推送、问答、审批全走微信 iLink,
# 兜底是下面那组 SMTP。微信会话用 python -m lifein.admin login-weixin 扫码配。

# ---------- 采集入口(P1 起使用) ----------
# 采集与查询的密钥不在这里:它们按设备签发,加密存 credentials 表
# (python -m lifein.admin issue-device),见 06 §6.1
INGEST_MAX_SKEW_S=300
APP_TOKEN_TTL_H=24

# ---------- 行为参数 ----------
# 有默认值,通常不用改;改了要能解释为什么
DAILY_DIGEST_AT=08:00
MAX_PROACTIVE_PUSH_PER_DAY=3
SHADOW_MODE_DEFAULT=true
TXN_DEDUP_WINDOW_S=300
TXN_MIN_CONFIDENCE=0.8
PENDING_EXPIRE_DAYS=30
APPROVAL_EXPIRE_H=24
COLLECTOR_HEARTBEAT_TIMEOUT_M=60
# 通知原文留多久,到期只清正文、行和元信息留着(R10)
NOTIFICATION_RETENTION_DAYS=7
ALERT_CHANNEL=email

# ---------- 邮件兜底通道(P1,可选)----------
# 配了 SMTP_HOST 就必须把这一组配全,否则启动即失败(07 §2.7)。
# 它是降级链的最后一环:前面两条的共同失效方式是平台,邮件不依赖平台政策。
# SMTP_PASSWORD 填授权码,不是登录密码。
SMTP_HOST=
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=
SMTP_USE_SSL=true
